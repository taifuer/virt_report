# DeepSeek API key (用于 AI 摘要; 不设置则走降级模板)
# 获取: https://platform.deepseek.com/
DEEPSEEK_API_KEY=

# 可选: GitLab token (公开项目无需; 设置可提高 API 限额)
# GITLAB_TOKEN=

# 运行状态页面和 /api/metrics 的访问密钥（生产环境必须使用随机长字符串）
METRICS_ACCESS_KEY=

# Docker 构建镜像（默认针对中国大陆网络；海外部署可在 .env 覆盖）
PYTHON_IMAGE=docker.m.daocloud.io/library/python:3.12-slim
DEBIAN_MIRROR=mirrors.aliyun.com
PIP_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
