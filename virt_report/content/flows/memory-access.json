  "scenarios": [
    {
      "id": "ram-hit", "label": "RAM · 转换缓存命中",
      "summary": "有效地址转换已经缓存。处理器检查权限后访问宿主物理内存，KVM 与 QEMU 不参与本次读取。",
      "assumptions": ["Intel VMX + EPT，x86-64，4 KiB 页；不含嵌套虚拟化。", "读取 GVA 0x40203080 的 32 位值，目标内存值为 0x12345678。", "当前地址空间的组合转换缓存有效、权限允许；未发生并发失效。", "转换缓存命中与 CPU 数据缓存命中是两件事，本演示不模拟缓存层级与访问时延。"],
      "nodes": [{"id": "guest", "label": "Guest 指令", "role": "客户机用户态"}, {"id": "mmu", "label": "CPU MMU / TLB", "role": "硬件地址转换"}, {"id": "ram", "label": "宿主物理内存", "role": "RAM 后备页"}, {"id": "kvm", "label": "KVM", "role": "本次不介入"}, {"id": "qemu", "label": "QEMU", "role": "已完成 RAM 注册"}],
      "links": [{"id": "lookup", "from": "guest", "to": "mmu", "label": "GVA 与读取权限", "kind": "translation"}, {"id": "read", "from": "mmu", "to": "ram", "label": "HPA 0x21000080", "kind": "data"}, {"id": "result", "from": "ram", "to": "guest", "label": "读取结果", "kind": "data"}],
      "structures": [
        {"id": "addresses", "title": "本次访问的地址", "kind": "address", "fields": [{"key": "gva", "label": "Guest 虚拟地址", "initial": "0x0000000040203080"}, {"key": "gpa", "label": "对应 GPA", "initial": "0x00403080（既有映射）"}, {"key": "hpa", "label": "对应 HPA", "initial": "0x21000080（既有映射）"}]},
        {"id": "translation", "title": "映射与执行状态", "kind": "registers", "fields": [{"key": "cache", "label": "转换缓存", "initial": "当前上下文有有效条目"}, {"key": "permission", "label": "访问权限", "initial": "Guest PTE 与 EPT 均允许读取"}, {"key": "value", "label": "目标寄存器 EAX", "initial": "尚未更新"}, {"key": "instruction", "label": "当前读取", "initial": "尚未执行"}, {"key": "userspace", "label": "返回 QEMU", "initial": "否"}]}
      ],
      "steps": [
        {"id": "ready", "title": "访问前", "actor": "Guest 用户态", "description": "读取指令准备访问 GVA 0x40203080。既有页表和转换缓存均有效。", "detail": "页表给出 GPA 0x00403080、HPA 0x21000080；初始图展示已存在的关系，尚未执行本次读取。", "active": [], "links": [], "changes": {}, "nodeStates": {}, "sourceIds": ["address-model"], "focus": true},
        {"id": "lookup", "title": "查询地址转换", "actor": "CPU 硬件", "description": "处理器用当前地址空间与 GVA 查询转换缓存。", "detail": "缓存标签包含地址空间相关信息，切换虚机或进程后不能直接套用其他上下文的映射。这里展示逻辑转换，不模拟处理器内部微操作次序。", "active": ["guest", "mmu"], "links": ["lookup"], "changes": {"instruction": "读取进行中", "cache": "匹配当前上下文"}, "nodeStates": {"mmu": "查询转换"}, "sourceIds": ["address-model"], "focus": true},
        {"id": "hit", "title": "取得已缓存的映射", "actor": "CPU 硬件", "description": "有效转换直接给出目标 HPA，并通过本次读取的权限检查。", "detail": "命中时无需重新遍历 Guest 页表与 EPT。GPA 表示两级转换中的逻辑中间地址，不要求硬件在每次命中时先输出 GPA 再做第二次软件查询。", "active": ["mmu"], "links": [], "changes": {"cache": "命中，无需页表遍历", "permission": "本次读取权限检查通过"}, "nodeStates": {"mmu": "命中有效转换"}, "sourceIds": ["address-model"], "focus": true},
        {"id": "load", "title": "读取后备内存", "actor": "CPU 硬件", "description": "沿 HPA 0x21000080 读取 4 字节，得到 0x12345678。", "detail": "数据可能由 CPU 缓存提供，也可能需要继续访问内存层级。转换命中本身并不保证数据已经在缓存中。", "active": ["mmu", "ram"], "links": ["read"], "changes": {"hpa": "0x21000080 · 读取 4 B"}, "nodeStates": {"ram": "返回 0x12345678"}, "sourceIds": ["address-model"], "focus": true},
        {"id": "complete", "title": "完成读取", "actor": "Guest 用户态", "description": "结果写入 EAX，客户机继续执行下一条指令。", "detail": "本次访问没有引发 EPT VM-Exit，也没有让 KVM_RUN 返回 QEMU。QEMU 先前的内存注册仍是这条硬件路径成立的前提。", "active": ["guest"], "links": ["result"], "changes": {"value": "0x12345678", "instruction": "读取完成，进入下一条指令"}, "nodeStates": {"guest": "继续执行"}, "sourceIds": ["address-model", "memory-slot"], "focus": true}
      ]
    },
    {
      "id": "tlb-miss", "label": "RAM · TLB 未命中",
      "summary": "转换缓存没有目标条目，但 Guest 页表和 EPT 都有效。硬件遍历页表后完成访问，不需要软件缺页处理。",
      "assumptions": ["Intel VMX + EPT，4 KiB 页；读取 GVA 0x40203080 的 32 位值。", "Guest 各级页表和对应 EPT 均有效，目标数据页也有允许读取的 EPT 映射。", "本例只展开最终叶子关系，页表遍历缓存可以省略部分中间访问。"],
      "nodes": [{"id": "guest", "label": "Guest 指令", "role": "客户机用户态"}, {"id": "mmu", "label": "CPU MMU / TLB", "role": "硬件遍历"}, {"id": "gpt", "label": "Guest 页表", "role": "GVA → GPA"}, {"id": "ept", "label": "EPT", "role": "GPA → HPA"}, {"id": "ram", "label": "宿主物理内存", "role": "目标数据"}, {"id": "kvm", "label": "KVM / QEMU", "role": "本次不介入"}],
      "links": [{"id": "lookup", "from": "guest", "to": "mmu", "label": "GVA 0x40203080", "kind": "translation"}, {"id": "guest-walk", "from": "mmu", "to": "gpt", "label": "遍历 Guest 页表", "kind": "translation"}, {"id": "table-ept", "from": "gpt", "to": "ept", "label": "页表页也需 EPT 转换", "kind": "translation"}, {"id": "data-ept", "from": "mmu", "to": "ept", "label": "目标 GPA 0x00403080", "kind": "translation"}, {"id": "read", "from": "ept", "to": "ram", "label": "HPA 0x21000080", "kind": "data"}, {"id": "result", "from": "ram", "to": "guest", "label": "0x12345678", "kind": "data"}],
      "structures": [
        {"id": "addresses", "title": "硬件地址转换", "kind": "address", "fields": [{"key": "gva", "label": "GVA", "initial": "0x0000000040203080"}, {"key": "gpa", "label": "本次解析 GPA", "initial": "尚未解析"}, {"key": "hpa", "label": "本次解析 HPA", "initial": "尚未解析"}]},
        {"id": "tables", "title": "页表与缓存", "kind": "registers", "fields": [{"key": "cache", "label": "转换缓存", "initial": "目标条目缺失"}, {"key": "guest-pte", "label": "Guest PTE", "initial": "P=1 · 映射 GPA 页 0x00403000"}, {"key": "ept-leaf", "label": "目标 EPT 叶子", "initial": "R=1 · 映射 HPA 页 0x21000000"}, {"key": "instruction", "label": "当前读取", "initial": "尚未执行"}, {"key": "value", "label": "EAX", "initial": "尚未更新"}, {"key": "userspace", "label": "返回 QEMU", "initial": "否"}]}
      ],
      "steps": [
        {"id": "ready", "title": "访问前", "actor": "Guest 用户态", "description": "目标地址暂时没有转换缓存条目，页表映射已经准备好。", "detail": "TLB 未命中描述缓存状态；是否发生异常，还取决于接下来遍历到的页表内容和权限。", "active": [], "links": [], "changes": {}, "nodeStates": {}, "sourceIds": ["address-model"], "focus": true},
        {"id": "miss", "title": "转换缓存未命中", "actor": "CPU MMU", "description": "处理器查询 GVA 0x40203080，启动硬件页表遍历。", "detail": "在本例的 EPT 配置下，普通 TLB miss 本身不产生 VM-Exit，也不会调用 QEMU。", "active": ["guest", "mmu"], "links": ["lookup"], "changes": {"cache": "未命中，开始硬件遍历", "instruction": "等待地址转换"}, "nodeStates": {"mmu": "页表遍历"}, "sourceIds": ["address-model"], "focus": true},
        {"id": "guest-leaf", "title": "解析 Guest 页表", "actor": "CPU MMU", "description": "硬件读取 Guest 页表，得到 GPA 页 0x00403000，加上偏移 0x080。", "detail": "Guest 页表存放在 Guest 物理内存中，读取页表页本身也要经过 EPT。本图将重复的层级遍历收束为一条关系。", "active": ["mmu", "gpt", "ept"], "links": ["guest-walk", "table-ept"], "changes": {"gpa": "0x00403080", "guest-pte": "已读取 · P=1 · 本次读取允许"}, "nodeStates": {"gpt": "得到目标 GPA"}, "sourceIds": ["address-model"], "focus": true},
        {"id": "ept-leaf", "title": "解析目标 EPT 叶子", "actor": "CPU MMU", "description": "目标 GPA 有有效 EPT 映射，页内偏移保持为 0x080。", "detail": "叶子给出 HPA 页 0x21000000，本次地址为 0x21000080。两级权限都允许访问，硬件无需请求软件修复。", "active": ["mmu", "ept"], "links": ["data-ept"], "changes": {"hpa": "0x21000080", "ept-leaf": "已读取 · R=1 · HPA 页 0x21000000", "cache": "取得有效转换，可供后续复用"}, "nodeStates": {"ept": "目标页映射有效"}, "sourceIds": ["address-model"], "focus": true},
        {"id": "load", "title": "完成数据读取", "actor": "CPU 硬件", "description": "处理器读取目标内存，将 0x12345678 写入 EAX。", "detail": "与缓存命中相比，这次增加了页表遍历成本；整个成功路径仍由硬件完成。", "active": ["ram", "guest"], "links": ["read", "result"], "changes": {"value": "0x12345678", "instruction": "读取完成，进入下一条指令"}, "nodeStates": {"guest": "继续执行"}, "sourceIds": ["address-model"], "focus": true}
      ]
    },
    {
      "id": "guest-page-fault", "label": "Guest #PF · 按需分配",
      "summary": "客户机应用首次写入合法匿名映射，Guest PTE 尚不存在。客户机内核分配并映射页面，返回后重试写入。",
      "assumptions": ["Guest 运行 Linux 6.18；匿名私有 VMA 允许读写，目标 PTE 为 non-present。", "Guest 用户态写入 0x12345678；未启用 userfaultfd，不发生内存不足。", "本例由 Guest 分配器选到 GPA 页 0x00403000；该页以及页表页已有可写 EPT 与驻留的宿主后备页。", "Intel EPT 已启用，本例 Guest #PF 不被 VMX 拦截；不含特殊 MAXPHYADDR 或嵌套配置。"],
      "nodes": [{"id": "guest", "label": "Guest 应用", "role": "首次写入"}, {"id": "mmu", "label": "CPU MMU", "role": "检查 Guest PTE"}, {"id": "guest-os", "label": "Guest Linux", "role": "VMA 与页分配"}, {"id": "gpt", "label": "Guest 页表", "role": "新增叶子 PTE"}, {"id": "ram", "label": "已映射的 RAM", "role": "EPT 与宿主页就绪"}, {"id": "kvm", "label": "KVM / QEMU", "role": "本次不介入"}],
      "links": [{"id": "write", "from": "guest", "to": "mmu", "label": "写 GVA 0x40203080", "kind": "translation"}, {"id": "fault", "from": "mmu", "to": "guest-os", "label": "Guest #PF · CR2", "kind": "control"}, {"id": "allocate", "from": "guest-os", "to": "ram", "label": "分配并清零 Guest 页", "kind": "data"}, {"id": "install", "from": "guest-os", "to": "gpt", "label": "建立可写 PTE", "kind": "control"}, {"id": "return", "from": "guest-os", "to": "guest", "label": "异常返回，重试原指令", "kind": "control"}, {"id": "store", "from": "guest", "to": "ram", "label": "写入 0x12345678", "kind": "data"}],
      "structures": [
        {"id": "addresses", "title": "Guest 地址与异常", "kind": "address", "fields": [{"key": "gva", "label": "写入 GVA", "initial": "0x0000000040203080"}, {"key": "gpa", "label": "本次目标 GPA", "initial": "尚无 Guest 映射"}, {"key": "cr2", "label": "Guest CR2", "initial": "本次尚未更新"}, {"key": "pf-error", "label": "#PF 错误码", "initial": "尚未发生"}]},
        {"id": "mapping", "title": "按需分配状态", "kind": "registers", "fields": [{"key": "vma", "label": "Guest VMA", "initial": "合法匿名私有映射 · 允许读写"}, {"key": "guest-pte", "label": "Guest PTE", "initial": "P=0 · 未建立映射"}, {"key": "ept-leaf", "label": "将分配页的 EPT", "initial": "已存在 · 可读写 · HPA 页 0x21000000"}, {"key": "value", "label": "目标 4 B", "initial": "尚未分配给此 Guest VMA"}, {"key": "instruction", "label": "应用写指令", "initial": "尚未执行"}, {"key": "userspace", "label": "返回 QEMU", "initial": "否"}]}
      ],
      "steps": [
        {"id": "ready", "title": "访问前", "actor": "Guest 用户态", "description": "应用已有合法的匿名地址范围，目标页尚未分配。", "detail": "创建 VMA 与建立每一个 PTE 可以发生在不同时间。这里从目标页的首次写入开始。", "active": [], "links": [], "changes": {}, "nodeStates": {}, "sourceIds": ["guest-fault"], "focus": true},
        {"id": "fault", "title": "产生 Guest #PF", "actor": "CPU 硬件", "description": "Guest PTE 的 P 位为 0，处理器转入客户机的缺页异常处理入口。", "detail": "CR2 记录 GVA 0x40203080，错误码为 0x6：non-present、write、user。原应用写指令尚未完成。本例无需先退出到 KVM。", "active": ["guest", "mmu", "guest-os"], "links": ["write", "fault"], "changes": {"cr2": "0x0000000040203080", "pf-error": "0x6 · P=0 / W=1 / U=1", "instruction": "缺页挂起 · 保存的 RIP 指向原写指令"}, "nodeStates": {"guest-os": "处理 Guest #PF"}, "sourceIds": ["guest-fault", "vmx-exceptions"], "focus": true},
        {"id": "validate", "title": "检查地址范围", "actor": "Guest Linux 内核", "description": "do_user_addr_fault() 找到对应 VMA，确认应用具有写权限，交给 handle_mm_fault()。", "detail": "本例选择可修复的匿名缺页。若地址不属于合法 VMA 或权限不允许，Guest 可能给应用发送 SIGSEGV，不会继续本例的分配路径。", "active": ["guest-os"], "links": [], "changes": {"vma": "查找成功 · 写权限检查通过"}, "nodeStates": {"guest-os": "允许按需分配"}, "sourceIds": ["guest-fault"], "focus": true},
        {"id": "allocate", "title": "分配并建立 Guest PTE", "actor": "Guest Linux 内核", "description": "客户机分配、清零 GPA 页 0x00403000，并建立应用虚拟页的可写映射。", "detail": "这个 GPA 页对应的 EPT 和宿主页已就绪。Guest 内核管理自己的页分配与 PTE，无需调用 QEMU 设备模型。", "active": ["guest-os", "ram", "gpt"], "links": ["allocate", "install"], "changes": {"gpa": "0x00403080", "guest-pte": "P=1 / RW=1 / U=1 · GPA 页 0x00403000", "value": "0x00000000（新页已清零）"}, "nodeStates": {"gpt": "可写映射就绪"}, "sourceIds": ["guest-fault", "address-model"], "focus": true},
        {"id": "retry", "title": "返回并重试原写入", "actor": "Guest 用户态", "description": "异常返回恢复应用执行，处理器重新执行同一条写指令。", "detail": "硬件现在能完成 Guest 页表与 EPT 转换，目标地址是 HPA 0x21000080。页故障处理期间 Guest 内核执行了其他指令，应用的这条写指令一直保持待完成。", "active": ["guest-os", "guest", "ram"], "links": ["return", "store"], "changes": {"value": "0x12345678", "instruction": "写入完成，进入下一条指令"}, "nodeStates": {"guest": "恢复应用执行", "ram": "接收写入值"}, "sourceIds": ["guest-fault", "address-model"], "focus": true}
      ]
    },
    {
      "id": "ept-missing", "label": "EPT · 映射尚未建立",
      "summary": "Guest 页表有效，目标 RAM 页没有 EPT 叶子。KVM 由 memslot 找到已有宿主页，建立第二级映射后重试。",
